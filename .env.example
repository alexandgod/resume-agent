# 简历生成 Agent —— 环境变量示例（复制为 .env 后按需修改）
# 本文件只允许出现占位符，严禁写入任何真实密钥值。
# 未配置 LLM_API_KEY 时，系统 100% 走本地规则化生成，闭环不受影响。

# ── 服务与存储 ──────────────────────────────────────────
PORT=3001
DATA_DIR=./data
NODE_ENV=development

# ── 会话 ────────────────────────────────────────────────
# 生产环境必须把 <set-a-random-secret> 替换成随机长字符串
JWT_SECRET=<set-a-random-secret>
JWT_EXPIRES_IN=7d

# ── 上传与限流 ──────────────────────────────────────────
MAX_FILE_SIZE_MB=10
MAX_MATERIALS_PER_USER=50
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ── 分享二维码 ──────────────────────────────────────────
# 手机与电脑同一局域网扫码时，把 localhost 改成本机局域网 IP:5173
PUBLIC_BASE_URL=http://localhost:5173

# ── 部署级大模型配置（CR-001 来源 env） ─────────────────
# 统一 OpenAI 兼容协议，不绑定厂商；用户「设置 → 模型配置」优先级更高。
LLM_BASE_URL=https://api.openai.com/v1
# 留空即视为未配置（自动规则化生成）；如需启用请替换为 <your-api-key> 并重启服务
LLM_API_KEY=
LLM_MODEL=<your-model-name>
LLM_TIMEOUT=30000

# ── 用户级密钥加密（CR-001） ────────────────────────────
# AES-256-GCM 加密密钥，仅存于服务端环境变量，永不入库。
# 留空时由 JWT_SECRET 经 scrypt 派生，保证零配置可跑；生产建议显式填写 <set-a-random-secret>
MODEL_CONFIG_SECRET=<set-a-random-secret>
TEST_CONNECT_TIMEOUT=10000
